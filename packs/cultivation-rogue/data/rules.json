{
  "rules": [
    {
      "when": {"key": "belief.sword", "op": "gte", "value": 2},
      "set": {"qi": {"add": 1}}
    },
    {
      "when": {"key": "belief.body", "op": "gte", "value": 2},
      "set": {"qi": {"add": 1}}
    },
    {
      "when": {"key": "turn", "op": "gte", "value": 1},
      "set": {"insight": {"add": 1}}
    },
    {
      "when": {"key": "tick", "op": "gte", "value": 12},
      "set": {"year": {"value": 1}}
    },
    {
      "when": {"key": "tick", "op": "gte", "value": 24},
      "set": {"year": {"value": 2}}
    },
    {
      "when": {"key": "tick", "op": "gte", "value": 36},
      "set": {"year": {"value": 3}}
    },
    {
      "when": {"key": "field", "op": "gte", "value": 1},
      "set": {"stone": {"add": 1}}
    },
    {
      "when": {"key": "field", "op": "gte", "value": 3},
      "set": {"stone": {"add": 1}}
    },
    {
      "when": {"key": "field", "op": "gte", "value": 6},
      "set": {"stone": {"add": 1}}
    },
    {
      "when": {"key": "year", "op": "gte", "value": 1},
      "set": {"stone": {"add": -1}}
    },
    {
      "when": {"key": "year", "op": "gte", "value": 2},
      "set": {"stone": {"add": -1}}
    },
    {
      "when": {"key": "year", "op": "gte", "value": 3},
      "set": {"stone": {"add": -1}}
    },
    {
      "when": [{"key": "year", "op": "gte", "value": 1}, {"key": "wall", "op": "lt", "value": 3}],
      "set": {"breach": {"value": 1}}
    },
    {
      "when": [{"key": "year", "op": "gte", "value": 2}, {"key": "wall", "op": "lt", "value": 6}],
      "set": {"breach": {"value": 2}}
    },
    {
      "when": [{"key": "year", "op": "gte", "value": 3}, {"key": "wall", "op": "lt", "value": 9}],
      "set": {"breach": {"value": 3}}
    },
    {
      "when": [{"key": "year", "op": "gte", "value": 1}, {"key": "stone", "op": "lte", "value": 0}],
      "set": {"ruin": {"value": 1}}
    }
  ]
}
