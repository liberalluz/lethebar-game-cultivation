{
  "base": "main",
  "branch_prefix": "batch/",
  "docs_root": "",
  "scope": {
    "ignore": [],
    "generated": []
  },
  "checks": [
    {
      "name": "translation",
      "command": [
        "python",
        "infra/checks/check_translation.py"
      ],
      "cwd": "."
    }
  ],
  "pr_create": [],
